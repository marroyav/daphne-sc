[Unit]
Description=DAPHNE Rust slow-control server
After=network-online.target firmware.service clockchip.service endpoint.service
Wants=network-online.target
Requires=firmware.service clockchip.service endpoint.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/firmware
EnvironmentFile=-/etc/daphne-board.env
EnvironmentFile=-/etc/daphne-sc.env
ExecStart=/usr/local/bin/daphne-sc-server
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
