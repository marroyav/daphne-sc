# Example /etc/daphne-sc.env for the Rust slow-control stack.
#
# Keep CLOCKCHIP_* aligned with /etc/daphne-board.env when both files exist.

DAPHNE_SC_BIND=tcp://*:40002
DAPHNE_SC_RPU_TIMEOUT_MS=200
# DAPHNE_SC_RPU_RPMSG=/dev/rpmsg_daphne_afe

CLOCKCHIP_BUS=2
CLOCKCHIP_ADDR=0x70

# Default endpoint.service ready state is 0x8 and requires TIMESTAMP_OK=1.
# ENDPOINT_SUCCESS_STATES=0x8
